# Copy to .env and fill in the values.

# Postgres connection string. Point this at your existing Postgres
# instance — docker-compose.yml does NOT spin up a Postgres for you.
# Create a dedicated DB for this app first:
#   psql -U postgres -c "CREATE DATABASE findmy_family;"
DATABASE_URL="postgresql://USER:PASS@localhost:5432/findmy_family"

# Anisette (runs in Docker on this port)
ANISETTE_URL="http://localhost:6969"

# 32-byte hex string used to AES-GCM-encrypt private keys and Apple tokens
# at rest in the DB. Generate with: openssl rand -hex 32
MASTER_KEY=""

# Auth.js — random secret used to sign session JWTs
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Where the app is hosted (for redirect URLs)
AUTH_URL="http://localhost:3000"

# Nominatim — required by their TOS. Include an email or contact URL.
NOMINATIM_USER_AGENT="findmy-family/0.1 (you@example.com)"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
